# Copy to .env.local for local development. Never commit real values.
# With GOOGLE_SERVICE_ACCOUNT_JSON and CALENDAR_IDS unset, the board runs on sample data.

# Base64 of the service account key file: base64 -w0 key.json  (macOS: base64 -i key.json)
GOOGLE_SERVICE_ACCOUNT_JSON=

# JSON map of calendar name (shown on the board as the crew) to calendar id.
CALENDAR_IDS={"Crew 1 · Fernando":"...@group.calendar.google.com","Crew 2 · Jorge":"...@group.calendar.google.com","Crew 3 · Darwin":"...@group.calendar.google.com","Crew 4 · Jhonny":"...@group.calendar.google.com","Felipe":"...@group.calendar.google.com","Excavation · Bira":"...@group.calendar.google.com","Sealing · Jardel":"...@group.calendar.google.com"}

# Required in production (the app refuses all requests without it). At least 24 characters.
# Generate one with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BOARD_ACCESS_TOKEN=

# Control screen users are added by an admin at /control/users and kept in a private Google Sheet, shared with the
# service account above as Editor (Google Sheets API enabled). The ID is in the sheet's address: /spreadsheets/d/<ID>/edit
USERS_SHEET_ID=
# Optional: users fixed in Vercel instead (read-only on the Users page). "password" is a PBKDF2 hash, never the password.
CONTROL_USERS=

# Office location for the weather forecast (defaults to Rockledge, FL).
HQ_LAT=
HQ_LON=

# Map style: OpenStreetMap on the live board by default; "schematic" = the prototype's drawn map.
# With sample data, "osm" previews OpenStreetMap.
MAP_STYLE=

